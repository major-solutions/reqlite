{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "uvx --quiet --from \"${CLAUDE_PLUGIN_ROOT}\" --exclude-newer \"7 days\" reqlite commit-gate",
            "timeout": 180
          },
          {
            "type": "command",
            "if": "Bash(git -C *)",
            "command": "uvx --quiet --from \"${CLAUDE_PLUGIN_ROOT}\" --exclude-newer \"7 days\" reqlite commit-gate",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
